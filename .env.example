# ---------------------------------------------------------------------------
# Synapse — environment template
# Copy to `.env.local` and fill in.  NEVER commit `.env.local`.
# Everything here is free-tier; see learn.md §11.
# ---------------------------------------------------------------------------

# --- Supabase (project settings → API) -------------------------------------
# Safe to expose to the browser: RLS is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — use exclusively in route handlers / migrations.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider (pick at least one) --------------------------------------
# Configure BOTH and the app fails over automatically when one is rate-limited
# or erroring. Whichever LLM_PROVIDER names is tried first.
#
# Groq free tier: 8000 tokens/minute, which is tight - one roadmap uses most of
# a minute's budget, so a repair retry or a second user gets a 429.
GROQ_API_KEY=

# Google Gemini free tier: ~250 requests/day with a far larger token ceiling,
# which is why it is the recommended primary. No credit card required.
GEMINI_API_KEY=

# Which provider /api/generate tries first: "gemini" | "groq"
LLM_PROVIDER=gemini

# Model ids are retired by the providers on their own schedule, so they are
# overridable without a code change. A model listed by `GET /v1beta/models` is
# not proof it still works: gemini-2.5-flash is still listed but returns
# 404 "no longer available to new users". Only a real call proves a model.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Paper discovery ---------------------------------------------------------
# OpenAlex is the discovery source and needs NO key. The arXiv Atom API stays
# as the fallback for a chosen paper when OpenAlex has no record.
# Optional: a contact address puts us in OpenAlex's "polite pool".
# OPENALEX_MAILTO=you@example.com

# --- arXiv ------------------------------------------------------------------
# Optional override; defaults to the public export endpoint.
# ARXIV_API_URL=https://export.arxiv.org/api/query
