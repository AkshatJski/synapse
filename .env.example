# ---------------------------------------------------------------------------
# Synapse — environment template
# Copy to `.env.local` and fill in.  NEVER commit `.env.local`.
# Everything here is free-tier; see learn.md §11.
# ---------------------------------------------------------------------------

# --- Supabase (project settings → API) -------------------------------------
# Safe to expose to the browser: RLS is what protects the data, not the key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses RLS — use exclusively in route handlers / migrations.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- LLM provider (pick at least one) --------------------------------------
# Groq free tier — Llama 3.3 70B, fast JSON mode.
GROQ_API_KEY=

# Google Gemini free tier (alternative / fallback).
GEMINI_API_KEY=

# Which provider /api/generate prefers: "groq" | "gemini"
LLM_PROVIDER=groq

# --- arXiv ------------------------------------------------------------------
# Optional override; defaults to the public export endpoint.
# ARXIV_API_URL=https://export.arxiv.org/api/query
